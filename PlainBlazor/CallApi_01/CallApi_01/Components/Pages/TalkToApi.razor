@page "/TalkToApi"

@rendermode InteractiveServer

@inject HttpClient Http

<h3>File Server API</h3>

<!-- Example: Get Weather Forecast -->
<button @onclick="GetWeatherForecast">Get Weather Forecast</button>

<ul>
    @if (weatherForecasts != null)
    {
        @foreach (var forecast in weatherForecasts)
        {
            <li>
                <strong>@forecast.Date.ToShortDateString()</strong>:
                @forecast.Summary (@forecast.TemperatureC°C)
            </li>
        }
    }
</ul>


@code {

    private List<WeatherForecast>? weatherForecasts;

    private async Task GetWeatherForecast()
    {        
        var response = await Http.GetFromJsonAsync<List<WeatherForecast>>("https://localhost:7137/weatherforecast/?ApiKey=bubu2");

        weatherForecasts = response!;
    }

    public class WeatherForecast
    {
        public DateOnly Date { get; set; }
        public int TemperatureC { get; set; }
        public string? Summary { get; set; }
    }
}