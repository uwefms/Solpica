@page "/TalkToApiCodeBehind"

@rendermode InteractiveServer

<!-- Moved to CodeBehind -->
@* @inject HttpClient Http *@

<h3>File Server API</h3>

<!-- Example: Get Weather Forecast -->
<button @onclick="GetWeatherForecast">Get Weather Forecast</button>

@* <button @onclick="GetAllDir">Get All Dirs</button> *@

<ul>
    @if (weatherForecasts != null)
    {
        @foreach (var forecast in weatherForecasts)
        {
            <li>
                <strong>@forecast.Date.ToShortDateString()</strong>:
                @forecast.Summary (@forecast.TemperatureC°C)
            </li>
        }
    }
</ul>

<!-- Display Directory Files in a Table -->
@if (directoryFiles != null && directoryFiles.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Directory Name</th>
                <th>File Name</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var file in directoryFiles)
            {
                <tr>
                    <td>@file.DirName</td>
                    <td>@file.FileName</td>
                </tr>
            }
        </tbody>
    </table>
}
else if (directoryFiles == null)
{
    <p>No data available. Click the button to fetch directory files.</p>
}
else
{
    <p>Loading...</p>
}

