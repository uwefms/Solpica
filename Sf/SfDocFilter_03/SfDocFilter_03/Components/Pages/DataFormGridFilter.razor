@page "/dataFormGridFilter"

@* @layout BlankLayout *@

@namespace SfDocFilter_03.Components.Pages

<h1>DataFormGridFilter</h1>

@rendermode InteractiveServer

@using SfDocFilter.Dal.Models
@using SfDocFilter.Dal

<PageTitle>FilterForm</PageTitle>

@using Syncfusion.Blazor.DataForm
@using Syncfusion.Blazor.Buttons
@using System.ComponentModel.DataAnnotations
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Popups

<Syncfusion.Blazor.Popups.SfDialogProvider />

 <div class="control-section">
        <SfDataForm ID="FilterForm"
        Model="@SearchDetails"
        ColumnCount=3
        ColumnSpacing="20px"
        ButtonsAlignment="FormButtonsAlignment.Center">

            <SfButton Content="Search"
            CssClass="e-primary"
            IsPrimary="true"
            @onclick="SubmitForm">
            </SfButton>

            <FormValidator>
                <DataAnnotationsValidator></DataAnnotationsValidator>
            </FormValidator>
            <FormItems>

                <FormGroup LabelText="Group1">
                    <FormItem Field="@nameof(SearchDetails.First_name)" LabelText="First Name"></FormItem>
                    <FormItem Field="@nameof(SearchDetails.Last_name)" LabelText="Last Name"></FormItem>

                    @*                 <FormItem Field="@nameof(SearchDetails.EmailID)" LabelText="Email" Placeholder="someone@example.com"></FormItem>
                <FormItem Field="@nameof(SearchDetails.OrderDate)" LabelText="Order Date" EditorType="FormEditorType.DatePicker"></FormItem>
                <FormItem Field="@nameof(SearchDetails.AcceptTerms)" LabelText="Terms and Conditions" EditorType="FormEditorType.Switch"></FormItem>
 *@            </FormGroup>

                <FormGroup LabelText="Group 2" ColumnCount="2" ColumnSpacing="20px">
                    <FormItem Field="@nameof(SearchDetails.Country)" ColumnSpan="1" LabelText="Country"></FormItem>
                    <FormItem Field="@nameof(SearchDetails.City)" ColumnSpan="1" LabelText="City"></FormItem>

                    @*                 <FormItem Field="@nameof(SearchDetails.ShippedDate)" ColumnSpan="2" LabelText="Shipped Date" EditorType="FormEditorType.DatePicker"></FormItem>
                <FormItem Field="@nameof(SearchDetails.AddressLine)" ColumnSpan="2" EditorType="FormEditorType.TextArea" LabelText="Address Line"></FormItem>
                <FormItem Field="@nameof(SearchDetails.AddressLine2)" ColumnSpan="2" EditorType="FormEditorType.TextArea" LabelText="Address Line 2"></FormItem>
 *@
                    @* Sample for using RadioButtons *@
                    <FormItem Field="@nameof(SearchDetails.Marital_status)" ID="Marital_status">
                        <Template>
                            <label class="e-form-label">Marital status:</label>

                            <div class="rounded-border">

                                <div class="radio-group">
                                    <SfRadioButton Label="No Filter" Name="mstatus" Value="" TChecked="string"      @bind-Checked ="SearchDetails.Marital_status"></SfRadioButton>
                                    <SfRadioButton Label="Married" Name="mstatus" Value="Married" TChecked="string" @bind-Checked="SearchDetails.Marital_status"></SfRadioButton>
                                    <SfRadioButton Label="Single" Name="mstatus" Value="Single" TChecked="string" @bind-Checked="SearchDetails.Marital_status"></SfRadioButton>
                                </div>
                                <br />
 
                                <div class="radio-group">
                                    <SfRadioButton Label="Divorced" Name="mstatus" Value="Divorced" TChecked="string" @bind-Checked="SearchDetails.Marital_status"></SfRadioButton>
                                    <SfRadioButton Label="Widowed" Name="mstatus" Value="Widowed" TChecked="string" @bind-Checked="SearchDetails.Marital_status"></SfRadioButton>
                                </div>

                            </div>

                        </Template>
                    </FormItem>

                </FormGroup>

                <FormGroup LabelText="Group 3" ColumnCount="2" ColumnSpacing="20px">
                    <FormItem Field="@nameof(SearchDetails.First_name1)" LabelText="First Name"></FormItem>
                    <FormItem Field="@nameof(SearchDetails.Last_name1)" LabelText="Last Name"></FormItem>


                    @*                 <FormItem Field="@nameof(SearchDetails.Country1)" ColumnSpan="1" LabelText="Country1"></FormItem>
                <FormItem Field="@nameof(SearchDetails.City1)" ColumnSpan="1" LabelText="City1"></FormItem>
                <FormItem Field="@nameof(SearchDetails.ShippedDate1)" ColumnSpan="2" LabelText="Shipped Date1" EditorType="FormEditorType.DatePicker"></FormItem>
                <FormItem Field="@nameof(SearchDetails.AddressLine1)" ColumnSpan="2" EditorType="FormEditorType.TextArea" LabelText="Address Line1"></FormItem>
                <FormItem Field="@nameof(SearchDetails.AddressLine21)" ColumnSpan="2" EditorType="FormEditorType.TextArea" LabelText="Address Line 21"></FormItem>
 *@
                    @* Sample for using a ComboBox *@
                    <FormItem Field="@nameof(SearchDetails.State)" ID="State">
                        <Template>
                            <label class="e-form-label">State:</label>
                            <SfDropDownList TValue="string" Placeholder="e.g. Ohio" TItem="States" @bind-Value="@SearchDetails.State" DataSource="@State">
                                <DropDownListFieldSettings Value="Name"></DropDownListFieldSettings>
                            </SfDropDownList>
                        </Template>
                    </FormItem>

                </FormGroup>

            </FormItems>

            <FormButtons>

                @*   
                hide the autogenerated buttons
                <SfButton type="submit" CssClass="e-success">Register</SfButton>
                <SfButton type="button" CssClass="e-warning" OnClick="ClickHandler">Clear</SfButton>
             *@

            </FormButtons>

        </SfDataForm>
    </div>

<SfDialog 
    IsModal="true" 
    Width="1200px" 
    Height="800px"
    ShowCloseIcon="true"
    AllowDragging="true"
    EnableResize="true"
    @bind-Visible="ShowModal"> 
    <DialogTemplates>
        <Content>

            <h3 style="margin-right: 20px;">Test Data @Info (* = Contains Search)</h3>

            <SfGrid DataSource="@OnBaseList"
					TValue="OnBaseDto"
                    @ref="ResultGrid"
                    Locale="en"
                    AllowFiltering="true"
                    AllowReordering="true"
                    AllowResizing="true"                    
                    AllowSelection="true"
                    AllowMultiSorting="true"
                    EnablePersistence="false"                    
                    ShowColumnChooser="true"
                    ShowColumnMenu="false"
                    EnableVirtualization="true"
                    AllowPaging="false"
                    Height="110%"
                    Width="100%">

                <GridEditSettings AllowAdding="false" AllowEditing="false" AllowDeleting="false" Mode="EditMode.Normal"></GridEditSettings>
                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.FilterBar" Mode="FilterBarMode.Immediate" ImmediateModeDelay="200"></GridFilterSettings>

                <GridEvents TValue="OnBaseDto"
                            OnActionComplete="OnActionComplete">
                </GridEvents>

                <GridColumns>

                    <GridColumn Field=@nameof(OnBaseDto.TestDataId) HeaderText="Id" IsPrimaryKey="true" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" AutoFit="true" Visible="false"></GridColumn>
                    <GridColumn Field=@nameof(OnBaseDto.First_name) HeaderText="First Name" FilterSettings="@StartsWith" AutoFit="true"></GridColumn>
                    <GridColumn Field=@nameof(OnBaseDto.Last_name) HeaderText="Last Name" FilterSettings="@StartsWith" AutoFit="true"></GridColumn>
                    <GridColumn Field=@nameof(OnBaseDto.Birth_date) HeaderText="Birth date" Format="d" Type="Syncfusion.Blazor.Grids.ColumnType.Date" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" AutoFit="true"></GridColumn>
                    <GridColumn Field=@nameof(OnBaseDto.Full_name) HeaderText="Fullname *" FilterSettings="@Contains" AutoFit="true"></GridColumn>
                    <GridColumn Field=@nameof(OnBaseDto.Gender) HeaderText="Gender" FilterSettings="@StartsWith" AutoFit="true"></GridColumn>

                    <GridColumn Field=@nameof(OnBaseDto.Nationality) HeaderText="Nationality" FilterSettings="@StartsWith" AutoFit="true"></GridColumn>
                    <GridColumn Field=@nameof(OnBaseDto.Occupation) HeaderText="Occupation *" FilterSettings="@Contains" AutoFit="true"></GridColumn>
                    <GridColumn Field=@nameof(OnBaseDto.Marital_status) HeaderText="Marital_status" FilterSettings="@StartsWith" AutoFit="true"></GridColumn>
                    <GridColumn Field=@nameof(OnBaseDto.Street_address) HeaderText="Street_address" FilterSettings="@StartsWith" AutoFit="true"></GridColumn>
                    <GridColumn Field=@nameof(OnBaseDto.City) HeaderText="City" FilterSettings="@StartsWith" AutoFit="true"></GridColumn>
                    <GridColumn Field=@nameof(OnBaseDto.State) HeaderText="State" FilterSettings="@StartsWith" AutoFit="true"></GridColumn>
                    <GridColumn Field=@nameof(OnBaseDto.Country) HeaderText="Country" FilterSettings="@StartsWith" AutoFit="true" Visible="false"></GridColumn>

                    <GridColumn Field=@nameof(OnBaseDto.Postal_code) HeaderText="Postal_code" FilterSettings="@StartsWith" AutoFit="true" Visible="false"></GridColumn>
                    <GridColumn Field=@nameof(OnBaseDto.Phone_number) HeaderText="Phone_number" FilterSettings="@StartsWith" AutoFit="true" Visible="false"></GridColumn>
                    <GridColumn Field=@nameof(OnBaseDto.Email) HeaderText="Email" FilterSettings="@StartsWith" AutoFit="true" Visible="false"></GridColumn>
                    <GridColumn Field=@nameof(OnBaseDto.First_name1) HeaderText="First Name1" FilterSettings="@StartsWith" AutoFit="true" Visible="false"></GridColumn>
                    <GridColumn Field=@nameof(OnBaseDto.Last_name1) HeaderText="Last Name1" FilterSettings="@StartsWith" AutoFit="true" Visible="false"></GridColumn>

                    <GridColumn Field=@nameof(OnBaseDto.Document_type) HeaderText="Document_type" FilterSettings="@StartsWith" AutoFit="true"></GridColumn>
                    <GridColumn Field=@nameof(OnBaseDto.Issue_date) HeaderText="Issue_date" Format="d" Type="Syncfusion.Blazor.Grids.ColumnType.Date" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" AutoFit="true" Visible="false"></GridColumn>
                    <GridColumn Field=@nameof(OnBaseDto.Expiry_date) HeaderText="Expiry_date" Format="d" Type="Syncfusion.Blazor.Grids.ColumnType.Date" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" AutoFit="true" Visible="false"></GridColumn>
                </GridColumns>
            </SfGrid>

        </Content>
    </DialogTemplates>
</SfDialog>


<style>
    .control-section {
        min-height: 400px;
        width: 100%;
        padding: 20px;
    }

    .radio-group {
        display: flex;
        gap: 10px; /* Adjust spacing between radio buttons */
        align-items: center; /* Align items vertically */
    }

    .rounded-border {
        border: 2px solid #ccc; /* Border color and thickness */
        border-radius: 15px; /* Rounded corners */
        padding: 10px; /* Space inside the border */
        background-color: #f9f9f9; /* Optional: Background color */
    }

</style>

