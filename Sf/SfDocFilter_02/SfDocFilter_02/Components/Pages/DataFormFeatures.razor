@page "/dataform-features"

@rendermode InteractiveServer

@using SfDocFilter_02.Data

<h2>DataForm</h2>

<PageTitle>DataForm</PageTitle>

@using Syncfusion.Blazor.DataForm
@using Syncfusion.Blazor.Buttons
@using System.ComponentModel.DataAnnotations

<div class="control-section">
        <SfDataForm ID="MyForm"
                    Model="@OrderDetails"
                    ColumnCount=3
                    ColumnSpacing="20px"
                                        
                    ButtonsAlignment="FormButtonsAlignment.Center">

                    <SfButton
                        Content="Search"
                        CssClass="e-primary"
                        IsPrimary="true"
                        @onclick="SubmitForm">
                    </SfButton>

            <FormValidator>
                <DataAnnotationsValidator></DataAnnotationsValidator>
            </FormValidator>
            <FormItems>

                <FormGroup LabelText="User Information">
                    <FormItem Field="@nameof(OrderDetails.FirstName)" LabelText="First Name"></FormItem>
                    <FormItem Field="@nameof(OrderDetails.LastName)" LabelText="Last Name"></FormItem>
                    <FormItem Field="@nameof(OrderDetails.EmailID)" LabelText="Email" Placeholder="someone@example.com"></FormItem>
                    <FormItem Field="@nameof(OrderDetails.OrderDate)" LabelText="Order Date" EditorType="FormEditorType.DatePicker"></FormItem>
                    <FormItem Field="@nameof(OrderDetails.AcceptTerms)" LabelText="Terms and Conditions" EditorType="FormEditorType.Switch"></FormItem>
                </FormGroup>
                <FormGroup LabelText="Shipping Address" ColumnCount="2" ColumnSpacing="20px">
                    <FormItem Field="@nameof(OrderDetails.Country)" ColumnSpan="1" LabelText="Country"></FormItem>
                    <FormItem Field="@nameof(OrderDetails.City)" ColumnSpan="1" LabelText="City"></FormItem>
                    <FormItem Field="@nameof(OrderDetails.ShippedDate)" ColumnSpan="2" LabelText="Shipped Date" EditorType="FormEditorType.DatePicker"></FormItem>
                    <FormItem Field="@nameof(OrderDetails.AddressLine)" ColumnSpan="2" EditorType="FormEditorType.TextArea" LabelText="Address Line"></FormItem>
                    <FormItem Field="@nameof(OrderDetails.AddressLine2)" ColumnSpan="2" EditorType="FormEditorType.TextArea" LabelText="Address Line 2"></FormItem>
                </FormGroup>

                <FormGroup LabelText="Another Column" ColumnCount="2" ColumnSpacing="20px">
                    <FormItem Field="@nameof(OrderDetails.Country1)" ColumnSpan="1" LabelText="Country1"></FormItem>
                    <FormItem Field="@nameof(OrderDetails.City1)" ColumnSpan="1" LabelText="City1"></FormItem>
                    <FormItem Field="@nameof(OrderDetails.ShippedDate1)" ColumnSpan="2" LabelText="Shipped Date1" EditorType="FormEditorType.DatePicker"></FormItem>
                    <FormItem Field="@nameof(OrderDetails.AddressLine1)" ColumnSpan="2" EditorType="FormEditorType.TextArea" LabelText="Address Line1"></FormItem>
                    <FormItem Field="@nameof(OrderDetails.AddressLine21)" ColumnSpan="2" EditorType="FormEditorType.TextArea" LabelText="Address Line 21"></FormItem>
                </FormGroup>

            </FormItems>

            <FormButtons>

@*   

                hide the autogenerated buttons
                <SfButton type="submit" CssClass="e-success">Register</SfButton>
                <SfButton type="button" CssClass="e-warning" OnClick="ClickHandler">Clear</SfButton>
 *@
            </FormButtons>

        </SfDataForm>
</div>
@code {
    private OrderDetails OrderDetails = new OrderDetails();

    private void SubmitForm(object args) {
        // Implementation for form submission
        // Add your form submission logic here
    }




}
<style>
    .control-section {
        min-height: 400px;
        
        width: 100%;
        padding: 20px;
    }
</style>
